{
  "name": "@afilimax/broadcast-bot",
  "version": "0.1.0",
  "description": "Bot de divulgação open source da Afilimax: recebe suas ofertas pelo WebSocket e publica no Telegram, WhatsApp e Discord.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afilimax/am-broadcast-bot.git"
  },
  "homepage": "https://github.com/Afilimax/am-broadcast-bot#readme",
  "bugs": {
    "url": "https://github.com/Afilimax/am-broadcast-bot/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx ./src/cli.ts start",
    "start": "node ./dist/cli.js start",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "afilimax",
    "affiliate",
    "afiliados",
    "broadcast",
    "telegram",
    "whatsapp",
    "discord",
    "bot",
    "ofertas"
  ],
  "author": "Marcuth",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "discord.js": "^14.28.0",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io-client": "^4.8.4",
    "telegraf": "^4.16.3",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "afilimax-broadcast-bot": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.18"
  }
}
